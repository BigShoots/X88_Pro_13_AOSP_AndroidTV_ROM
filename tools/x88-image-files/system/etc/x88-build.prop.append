# X88 IR remote/display/CEC/Bluetooth support.
ro.hdmi.device_type=4
ro.hdmi.property_is_device_hdmi_cec_switch=false
ro.hdmi.cec_audio_device_forward_volume_keys_system_audio_mode_off=true
persist.sys.hdmi.control.enabled=1
persist.sys.hdmi.cec.switch.enabled=1
persist.sys.hdmi.cec.power_control_mode=to_tv
bluetooth.profile.hid.host.enabled=true
persist.bluetooth.btsnoopenable=true
persist.bluetooth.btsnooplogmode=full
persist.bluetooth.rtkcoex=true
