#!/system/bin/sh

log -t x88-cec-bt-setup "Applying HDMI-CEC and Bluetooth pairing defaults"

# Legacy Android TV HDMI-CEC globals used by HdmiControlService.
settings put global hdmi_control_enabled 1
settings put global hdmi_control_auto_wakeup_enabled 1
settings put global hdmi_control_auto_device_off_enabled 1
settings put global hdmi_system_audio_control_enabled 1
settings put global hdmi_cec_volume_control_enabled 1
settings put global hdmi_control_volume_control_enabled 1

# Newer CEC config keys used by Android 12+.
settings put global hdmi_cec_enabled 1
settings put global hdmi_cec_version 6
settings put global routing_control 1
settings put global power_control_mode to_tv
settings put global power_state_change_on_active_source_lost none
settings put global system_audio_control 1
settings put global system_audio_mode_muting 1
settings put global volume_control_enabled 1
settings put global tv_wake_on_one_touch_play 1
settings put global tv_send_standby_on_sleep 1
settings put global set_menu_language 1

setprop persist.sys.hdmi.control.enabled 1
setprop persist.sys.hdmi.cec.switch.enabled 1
setprop persist.sys.hdmi.cec.power_control_mode to_tv

# Seed manual passthrough support for the formats exposed by the vendor audio
# policy if Android has not created these settings yet. This avoids starting
# with every surround format off while still preserving later user changes.
surround_mode="$(settings get global encoded_surround_output 2>/dev/null)"
surround_formats="$(settings get global encoded_surround_output_enabled_formats 2>/dev/null)"
if [ -z "${surround_mode}" ] || [ "${surround_mode}" = "null" ]; then
    settings put global encoded_surround_output 3
fi
if [ -z "${surround_formats}" ] || [ "${surround_formats}" = "null" ]; then
    settings put global encoded_surround_output_enabled_formats 5,6,7,8,18
fi

# Keep Bluetooth logging on for remote-side troubleshooting of pairing failures.
setprop persist.bleRemote.open 1
setprop persist.bluetooth.btsnoopenable true
setprop persist.bluetooth.btsnooplogmode full
setprop persist.bluetooth.rtkcoex true

if cmd package list packages com.swe.myapplication 2>/dev/null | grep -q com.swe.myapplication; then
    pm grant com.swe.myapplication android.permission.ACCESS_COARSE_LOCATION >/dev/null 2>&1 || true
    pm grant com.swe.myapplication android.permission.ACCESS_FINE_LOCATION >/dev/null 2>&1 || true
    pm grant com.swe.myapplication android.permission.BLUETOOTH_SCAN >/dev/null 2>&1 || true
    pm grant com.swe.myapplication android.permission.BLUETOOTH_CONNECT >/dev/null 2>&1 || true
    pm grant com.swe.myapplication android.permission.READ_EXTERNAL_STORAGE >/dev/null 2>&1 || true
    pm grant com.swe.myapplication android.permission.WRITE_EXTERNAL_STORAGE >/dev/null 2>&1 || true
    appops set com.swe.myapplication SYSTEM_ALERT_WINDOW allow >/dev/null 2>&1 || true
    am start-foreground-service --user 0 -n com.swe.myapplication/.DetectService --ei type 1 >/dev/null 2>&1 || true
    log -t x88-cec-bt-setup "Started stock Bluetooth remote pairing helper"
else
    log -t x88-cec-bt-setup "Bluetooth remote pairing helper package not installed"
fi
