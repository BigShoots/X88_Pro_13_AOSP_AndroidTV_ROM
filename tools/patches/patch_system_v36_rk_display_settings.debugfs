ea_set init.rc security.selinux u:object_r:system_file:s0
cd /system
rm build.prop
write /tmp/x88_v36_build_prop build.prop
sif build.prop mode 0100644
ea_set build.prop security.selinux u:object_r:system_file:s0
rm x88-rom-version
